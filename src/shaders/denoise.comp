#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64  : require
#extension GL_GOOGLE_include_directive : enable

#include "shared_structs.h"

const int kGroupSize = 128;
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba32f) uniform image2D inImage;
layout(set = 0, binding = 1, rgba32f) uniform image2D outImage;
layout(set = 0, binding = 2, rgba32f) uniform image2D kdBuff;
layout(set = 0, binding = 3, rgba32f) uniform image2D ndBuff;

layout(push_constant) uniform _pcDenoise { PushConstantDenoise pc; };
float gaussian[5] = float[5](1.0/16.0, 4.0/16.0, 6.0/16.0, 4.0/16.0, 1.0/16.0);

float Luminance(vec3 c)
{
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Luminance mapped to [0, 1) so a single very bright sample can't dominate the colour weight
float CompressedLuminance(vec3 c)
{
    float l = Luminance(c);
    return l / (1.0 + l);
}

void main()
{
    ivec2 gpos = ivec2(gl_GlobalInvocationID.xy);  // Index of central pixel being denoised
    
    // Central pixel: albedo (clamped so demodulation stays stable), color,
    // demodulated color, normal and depth
    vec4 cKdRaw = imageLoad(kdBuff, gpos);
    vec4 cIn = imageLoad(inImage, gpos);
    vec3 cVal = cIn.xyz;
    float cSamples = cIn.w;

    // Light sources (Kd.w = 1) are already noise free; filtering them would only spread them
    if (cKdRaw.w > 0.5)
    {
        imageStore(outImage, gpos, vec4(cVal, cSamples));
        return;
    }

    vec3 cKd = clamp(cKdRaw.xyz, vec3(0.1), vec3(1.0));
    vec3 cDem = cVal / cKd;

    // Outlier clamp: on the first pass, keep the centre's luminance within the range of its
    // 8 neighbours, which removes lone fireflies and lone black pixels
    if (pc.ClampFireflies != 0 && pc.StepWidth == 1)
    {
        float maxLum = -1.0;
        float minLum = 1e30;
        vec3 minDem = vec3(0.0);
        for (int i = -1; i <= 1; i++)
        {
            for (int j = -1; j <= 1; j++)
            {
                if (i == 0 && j == 0)
                    continue;
                ivec2 q = gpos + ivec2(i, j);
                vec4 qKd = imageLoad(kdBuff, q);
                if (qKd.w > 0.5)
                    continue;
                vec3 qDem = imageLoad(inImage, q).xyz / clamp(qKd.xyz, vec3(0.1), vec3(1.0));
                float qLum = Luminance(qDem);
                maxLum = max(maxLum, qLum);
                if (qLum < minLum)
                {
                    minLum = qLum;
                    minDem = qDem;
                }
            }
        }
        float lum = Luminance(cDem);
        if (maxLum >= 0.0 && lum > maxLum)
            cDem *= maxLum / lum;
        else if (maxLum >= 0.0 && lum < minLum)
            cDem = minDem;
    }

    // A pixel with few samples (just revealed by camera motion) is too noisy to trust its
    // own colour, so the colour weight fades in as samples accumulate
    float colorTrust = clamp(cSamples / 16.0, 0.0, 1.0);

    float cLum = CompressedLuminance(cDem);
    vec3 cNrm = imageLoad(ndBuff, gpos).xyz;
    float cDepth = imageLoad(ndBuff, gpos).w;
    
    vec3 numerator = vec3(0.0);
    float denominator = 0.0;
    for (int i=-2;  i<=2;  i++)
    {
        for (int j=-2;  j<=2;  j++) 
        {
            ivec2 offset = ivec2(i,j) * pc.StepWidth; // Offset of 5x5 pixels **with holes**
            // The same values for the offset pixel
            ivec2 total_offset = gpos + offset;
            vec4 pKdRaw = imageLoad(kdBuff, total_offset);
            if (pKdRaw.w > 0.5)
                continue;
            vec3 pKd = clamp(pKdRaw.xyz, vec3(0.1), vec3(1.0));
            vec3 pVal = imageLoad(inImage, total_offset).xyz;
            vec3 pDem = pVal / pKd;
            if (i == 0 && j == 0)
                pDem = cDem;
            vec3 pNrm = imageLoad(ndBuff, total_offset).xyz;
            float pDepth = imageLoad(ndBuff, total_offset).w;

            // The weight compares the offset pixel to the central one and is a product of:
            //  1-2: separable Gaussian taps in x and y
            float h_weight = gaussian[i + 2];
            float v_weight = gaussian[j + 2];
            //  3: depth similarity, exp(-t^2 / depthFactor) with t = cDepth - pDepth (1 if factor is 0)
            float t = cDepth - pDepth;
            float d_weight = exp(-(t * t) / pc.DepthFactor);
            if (pc.DepthFactor == 0.0f)
                d_weight = 1.0f;
            //  4: normal similarity, exp(-d / normFactor) with d = |cNrm - pNrm|^2 / stepwidth^2 (1 if factor is 0)
            vec3 _t = cNrm - pNrm;
            float d = dot(_t, _t) / float(pc.StepWidth * pc.StepWidth);
            float n_weight = exp(-d / pc.NormFactor);
            if (pc.NormFactor == 0.0f)
                n_weight = 1.0f;

            //  5: an albedo related weight. Dividing by a dark albedo inflates any specular light
            //     on that pixel, which would otherwise bleed onto brighter neighbours as a halo.
            vec3 kdDiff = cKd - pKd;
            float k_weight = exp(-dot(kdDiff, kdDiff) / pc.AlbedoFactor);
            if (pc.AlbedoFactor == 0.0f)
                k_weight = 1.0f;

            //  6: colour similarity, exp(-l^2 / colorFactor) on compressed luminance (1 if factor is 0).
            //     The factor halves each pass, so the wide passes don't smear noise into blocks.
            float l = cLum - CompressedLuminance(pDem);
            float c_weight = mix(1.0, exp(-(l * l) / pc.ColorFactor), colorTrust);
            if (pc.ColorFactor == 0.0f)
                c_weight = 1.0f;

            float weight = h_weight * v_weight * d_weight * n_weight * k_weight * c_weight;
            numerator += pDem * weight;
            denominator += weight;
        }
    }

    vec3 outVal = cKd * numerator / denominator; // Re-modulate the color
    if (denominator == 0)
        outVal = cVal;
    
    imageStore(outImage, gpos, vec4(outVal, cSamples));
}
