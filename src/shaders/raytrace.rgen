#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64  : require
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "shared_structs.h"
#include "RNG.glsl"

#define PI 3.14159265f

// The ray payload, attached to a ray; used to communicate between shader stages.
layout(location=0) rayPayloadEXT RayPayload payload;

// Push constant for ray tracing shaders
layout(push_constant) uniform _PushConstantRay { PushConstantRay pcRay; };

// Ray tracing descriptor set: 0:acceleration structure, and 1: color output image
layout(set=0, binding=0) uniform accelerationStructureEXT topLevelAS;
layout(set=0, binding=1, rgba32f) uniform image2D colCurr; // Output image: m_rtColCurrBuffer
layout(set=0, binding=2, rgba32f) uniform image2D colPrev;
layout(set=0, binding=3, rgba32f) uniform image2D NdCurr;
layout(set=0, binding=4, rgba32f) uniform image2D NdPrev;
layout(set=0, binding=5, rgba32f) uniform image2D KdCurr;
layout(set=0, binding=6, rgba32f) uniform image2D KdPrev;

// Object model descriptor set: 0: matrices, 1:object buffer addresses, 2: texture list
layout(set=1, binding=0) uniform _MatrixUniforms { MatrixUniforms mats; };
layout(set=1, binding=1, scalar) buffer ObjDesc_ { ObjDesc i[]; } objDesc;
layout(set=1, binding=2) uniform sampler2D textureSamplers[];

// Object buffered data; dereferenced from ObjDesc addresses
layout(buffer_reference, scalar) buffer Vertices {Vertex v[]; }; // Position, normals, ..
layout(buffer_reference, scalar) buffer Indices {ivec3 i[]; }; // Triangle indices
layout(buffer_reference, scalar) buffer Materials {Material m[]; }; // Array of all materials
layout(buffer_reference, scalar) buffer MatIndices {int i[]; }; // Material ID for each triangle

// BRDF functions
vec3 EvalBrdf(vec3 N, vec3 L, vec3 V, Material mat);
vec3 SampleLobe(vec3 A, float c, float phi);
vec3 SampleBrdf(inout uint seed, vec3 N, vec3 V, Material mat);
float PdfBrdf(vec3 N, vec3 L, vec3 V, Material mat);

void main() 
{
    // Push-constant layout check (see alignmentTest in shared_structs.h)
    if (pcRay.AlignmentTest != 1234) 
    {
      imageStore(colCurr, ivec2(gl_LaunchIDEXT.xy), vec4(1,0,0,0));
      return;
    }

    // This invocation is for a pixel indicated by gl_LaunchIDEXT
    const vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    vec2 pixelNDC = pixelCenter/vec2(gl_LaunchSizeEXT.xy)*2.0 - 1.0;
 
    // W means world
    vec3 eyeW   = (mats.ViewInverse * vec4(0, 0, 0, 1)).xyz;
    vec4 pixelH = mats.ViewInverse * mats.ProjInverse * vec4(pixelNDC.x, pixelNDC.y, 1, 1);
    vec3 pixelW = pixelH.xyz/pixelH.w;
    vec3 rayOrigin    = eyeW;
    vec3 rayDirection = normalize(pixelW - eyeW);

    // Calculate Seed
    payload.Seed = tea( gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x, pcRay.FrameSeed );
    vec3 C = vec3(0.0);
    vec3 W = vec3(1.0);

    // First-hit data for temporal accumulation and denoising
    bool firstHit = false;
    vec3 firstPos = vec3(0.0f);
    float firstDepth = 0.0f;
    vec3 firstNrm = vec3(0.0f);
    vec3 firstKd = vec3(0.0f);
    bool firstEmissive = false;

    // Loop through ray-by-ray along a path. Paths end by Russian roulette below;
    // pcRay.Depth is only an upper limit on their length.
    for(int i = 0; i < pcRay.Depth; ++i)
    {
        // Fire the ray;  hit or miss shaders will be invoked, passing results back in the payload
        traceRayEXT(topLevelAS,           // acceleration structure
                    gl_RayFlagsOpaqueEXT, // rayFlags
                    0xFF,                 // cullMask
                    0,                    // sbtRecordOffset for the hitgroups
                    0,                    // sbtRecordStride for the hitgroups
                    0,                    // missIndex
                    rayOrigin,            // ray origin
                    0.001,                // ray min range
                    rayDirection,         // ray direction
                    10000.0,              // ray max range
                    0                     // payload (location = 0)
                    );

        if (!payload.Hit)
            break;

        // If something was hit, find the object data.
        // Object data (containg 4 device addresses)
        ObjDesc    objResources = objDesc.i[payload.InstanceIndex];
        
        // Dereference the object's 4 device addresses
        Vertices   vertices    = Vertices(objResources.VertexAddress);
        Indices    indices     = Indices(objResources.IndexAddress);
        Materials  materials   = Materials(objResources.MaterialAddress);
        MatIndices matIndices  = MatIndices(objResources.MaterialIndexAddress);
  
        // Use gl_PrimitiveID to access the triangle's vertices and material
        ivec3 ind    = indices.i[payload.PrimitiveIndex]; // The triangle hit
        int matIdx   = matIndices.i[payload.PrimitiveIndex]; // The triangles material index
        Material mat = materials.m[matIdx]; // The triangles material

        // Vertex of the triangle (Vertex has pos, nrm, tex)
        Vertex v0 = vertices.v[ind.x];
        Vertex v1 = vertices.v[ind.y];
        Vertex v2 = vertices.v[ind.z];

        // Computing the normal and tex coord at hit position
        const vec3 bc   = payload.Bc; // The barycentric coordinates of the hit point
        const vec3 nrm  = bc.x*v0.Nrm      + bc.y*v1.Nrm      + bc.z*v2.Nrm;
        const vec2 uv   = bc.x*v0.TexCoord + bc.y*v1.TexCoord + bc.z*v2.TexCoord;

        // If the material has a texture, read diffuse color from it.
        if (mat.TextureId >= 0) {
            uint txtId = objResources.TxtOffset + mat.TextureId;
            mat.Diffuse = texture(textureSamplers[nonuniformEXT(txtId)], uv).xyz;
        }

        if (!pcRay.FullBrdf)
            mat.Specular = vec3(0.0f);

        // Orient the normals towards the incoming ray: instances have culling disabled, so
        // back faces are hit. Shading normal falls back to the geometric one if it faces away.
        vec3 Wo = -rayDirection; // Wi and Wo play the same role as L and V, in most BRDF presentations

        vec3 Ng = cross(v1.Pos - v0.Pos, v2.Pos - v0.Pos);
        Ng = dot(Ng, Ng) > 0.0f ? normalize(Ng) : Wo;
        if (dot(Ng, Wo) < 0.0f)
            Ng = -Ng;

        vec3 N = dot(nrm, nrm) > 0.0f ? normalize(nrm) : Ng;
        if (dot(N, Ng) < 0.0f)
            N = -N;
        if (dot(N, Wo) <= 0.0f)
            N = Ng;

        // Record first-hit data for temporal accumulation and denoising
        if (i == 0)
        {
            firstHit = true;
            firstPos = payload.HitPos;
            firstDepth = (mats.ViewProj * vec4(payload.HitPos, 1.0f)).w;  // View-space depth
            firstNrm = N;
            firstKd = mat.Diffuse;  // Checked: Done after the texture lookup
        }

        if (dot(mat.Emission, mat.Emission) > 0.0f)
        {
            if (i == 0)
                firstEmissive = true;
            C += mat.Emission * pcRay.EmissionScale * W;
            break;
        }

        vec3 Wi = SampleBrdf(payload.Seed, N, Wo, mat); // Importance sample output direction

        // A GGX sample can reflect below N, and a shading normal can send the sample
        // through the surface it was generated from. Neither carries any energy.
        if (dot(Wi, N) <= 0.0f || dot(Wi, Ng) <= 0.0f)
            break;

        vec3  f = EvalBrdf(N, Wi, Wo, mat); // Color (vec3) according to BRDF
        float p = PdfBrdf(N, Wi, Wo, mat); // Probability (float) of above sample of Wi

        const float epsilon = 1e-6;
        if (p < epsilon) { // epsilon = 10^-6; Mathematically impossible, but due to roundoff ...
            break;
        }

        W *= f / p; // Monte-Carlo estimator

        // Russian roulette, decided independently for each path
        if (rnd(payload.Seed) >= pcRay.Rr)
            break;
        W /= pcRay.Rr;

        // Step forward for next loop iteration
        rayOrigin = payload.HitPos;
        rayDirection = Wi;
    }

    //////////////////////////////////////////////////////////////////////////////////
    ////////////////////////////// History Tracking //////////////////////////////////
    //////////////////////////////////////////////////////////////////////////////////
    vec4 P = vec4(0.0f);
    float total_weight = 0.0f;

    if (firstHit && pcRay.UseHistory && !pcRay.Clear)
    {
        // Reproject into the prior frame. For this projection clip w is view-space depth, so
        // screenH.w is the depth this point should have recorded in NdPrev last frame.
        vec4 screenH = mats.PriorViewProj * vec4(firstPos, 1.0f);

        if (screenH.w > 0.0f)
        {
            vec2 screen = ((screenH.xy / screenH.w) + vec2(1.0f)) / 2.0f;

            if (all(greaterThanEqual(screen, vec2(0.0f))) && all(lessThanEqual(screen, vec2(1.0f))))
            {
                vec2 floc = screen * vec2(gl_LaunchSizeEXT.xy) - vec2(0.5f);
                vec2 base = floor(floc);
                vec2 offset = floc - base;
                ivec2 iloc = ivec2(base);

                for (int i = 0; i <= 1; ++i)
                {
                    for (int j = 0; j <= 1; ++j)
                    {
                        ivec2 loc = iloc + ivec2(i, j);
                        if (any(lessThan(loc, ivec2(0))) || any(greaterThanEqual(loc, ivec2(gl_LaunchSizeEXT.xy))))
                            continue;

                        vec4 prevNd = imageLoad(NdPrev, loc);

                        // d_threshold is the allowed depth difference, as a fraction of the depth
                        if (abs(screenH.w - prevNd.w) >= pcRay.DepthThreshold * screenH.w)
                            continue;
                        if (dot(firstNrm, prevNd.xyz) <= pcRay.NormalThreshold)
                            continue;

                        float bilinear_weight = (i == 0 ? 1.0f - offset.x : offset.x)
                                              * (j == 0 ? 1.0f - offset.y : offset.y);

                        total_weight += bilinear_weight;
                        P += imageLoad(colPrev, loc) * bilinear_weight;
                    }
                }
            }
        }
    }

    // With no usable history this starts from a count of 0, so the first sample replaces it.
    float oldN = 0.0f;
    vec3 oldAve = vec3(0.0f);

    if (total_weight > 1e-6f)
    {
        P /= total_weight;
        oldN = P.w;
        oldAve = P.xyz;

        // Limiting the count keeps new samples weighted at 1/maxSamples or more
        if (pcRay.MaxSamples > 0.0f)
            oldN = min(oldN, pcRay.MaxSamples - 1.0f);
    }

    // A non-finite sample must not enter the running average, so it is dropped.
    float newN = oldN;
    vec3 newAve = oldAve;

    if (!any(isnan(C)) && !any(isinf(C)))
    {
        newN = oldN + 1.0f;
        newAve = oldAve + (C - oldAve) / newN;
    }

    imageStore(colCurr, ivec2(gl_LaunchIDEXT.xy), vec4(newAve, newN));
    imageStore(KdCurr,  ivec2(gl_LaunchIDEXT.xy), vec4(firstKd, firstEmissive ? 1.0f : 0.0f));
    imageStore(NdCurr,  ivec2(gl_LaunchIDEXT.xy), vec4(firstNrm, firstDepth));
}

// BRDF functions
/////// ------------ GGX ----------
// Smith masking term for one direction (Walter et al. 2007). dotVN must be > 0.
float G1(float dotVN, float dotVH, float alphaSqr)
{
    if (dotVH <= 0.0f)
        return 0.0f;

    float cosSqr = dotVN * dotVN;
    float tanSqr = (1.0f - cosSqr) / cosSqr;
    return 2.0f / (1.0f + sqrt(1.0f + alphaSqr * tanSqr));
}

vec3 EvalBrdf(vec3 N, vec3 L, vec3 V, Material mat) // wi = L, wo = V
{
    float dotLN = dot(L, N);
    float dotVN = dot(V, N);
    if (dotLN <= 0.0f || dotVN <= 0.0f)
        return vec3(0.0f);

    vec3 Kd = mat.Diffuse;
    vec3 Ks = mat.Specular;
    vec3 H = normalize(V + L);

    float dotHN = clamp(dot(H, N), 0.0f, 1.0f);
    float dotLH = clamp(dot(L, H), 0.0f, 1.0f);
    float dotVH = clamp(dot(V, H), 0.0f, 1.0f);

    // shininess holds GGX roughness; the floor keeps D finite for near-mirror surfaces
    float alpha = max(mat.Shininess, 1e-3f);
    float alphaSqr = alpha * alpha;

    // F: Schlick. The grazing value is scaled so that materials authored with Ks = 0 stay non-specular.
    float f90 = clamp(50.0f * max(Ks.r, max(Ks.g, Ks.b)), 0.0f, 1.0f);
    float m = 1.0f - dotLH;
    vec3 F = Ks + (vec3(f90) - Ks) * (m * m * m * m * m);

    // D: GGX
    float d = dotHN * dotHN * (alphaSqr - 1.0f) + 1.0f;
    float D = alphaSqr / (PI * d * d);

    // G: Smith, evaluated separately for each direction
    float G = G1(dotLN, dotLH, alphaSqr) * G1(dotVN, dotVH, alphaSqr);

    vec3 specular = (D * F * G) / (4.0f * dotLN * dotVN);
    vec3 diffuse = (vec3(1.0f) - F) * Kd / PI; // Energy reflected specularly can't also scatter diffusely

    return dotLN * (diffuse + specular);
}

vec3 SampleLobe(vec3 A, float c, float phi)
{
    float s = sqrt(max(1.0f - c * c, 0.0f));
    vec3 K = vec3(s * cos(phi), s * sin(phi), c);

    if (abs(A.z - 1.0) < 1e-3)
        return K;

    if (abs(A.z + 1.0) < 1e-3)
        return vec3(K.x, -K.y, -K.z);

    A = normalize(A);
    vec3 B = normalize(vec3(-A.y, A.x, 0.0));
    vec3 C = cross(A, B);

    return K.x * B + K.y * C + K.z * A;
}

// Chance of sampling the specular lobe rather than the diffuse one, from the expected
// reflectance of each. Clamped so that neither lobe is ever left unsampled.
float SpecularProbability(vec3 N, vec3 V, Material mat)
{
    float f0 = max(mat.Specular.r, max(mat.Specular.g, mat.Specular.b));
    float kd = max(mat.Diffuse.r, max(mat.Diffuse.g, mat.Diffuse.b));

    float m = 1.0f - clamp(dot(N, V), 0.0f, 1.0f);
    float f90 = clamp(50.0f * f0, 0.0f, 1.0f);
    float F = f0 + (f90 - f0) * (m * m * m * m * m);

    float total = F + kd * (1.0f - F);
    return clamp(total > 0.0f ? F / total : 0.5f, 0.1f, 0.9f);
}

// Sample the GGX distribution of normals visible from V, then reflect V (Heitz 2018).
vec3 SampleGgx(inout uint seed, vec3 N, vec3 V, float alpha)
{
    vec3 T = abs(N.z) < 0.999f ? normalize(cross(vec3(0.0f, 0.0f, 1.0f), N)) : vec3(1.0f, 0.0f, 0.0f);
    vec3 B = cross(N, T);
    vec3 Vlocal = vec3(dot(V, T), dot(V, B), dot(V, N));

    vec3 Vh = normalize(vec3(alpha * Vlocal.x, alpha * Vlocal.y, Vlocal.z));
    float lenSqr = Vh.x * Vh.x + Vh.y * Vh.y;
    vec3 T1 = lenSqr > 0.0f ? vec3(-Vh.y, Vh.x, 0.0f) / sqrt(lenSqr) : vec3(1.0f, 0.0f, 0.0f);
    vec3 T2 = cross(Vh, T1);

    float r = sqrt(rnd(seed));
    float phi = 2.0f * PI * rnd(seed);
    float t1 = r * cos(phi);
    float t2 = r * sin(phi);
    float s = 0.5f * (1.0f + Vh.z);
    t2 = (1.0f - s) * sqrt(max(1.0f - t1 * t1, 0.0f)) + s * t2;

    vec3 Nh = t1 * T1 + t2 * T2 + sqrt(max(1.0f - t1 * t1 - t2 * t2, 0.0f)) * Vh;
    vec3 Hlocal = normalize(vec3(alpha * Nh.x, alpha * Nh.y, max(Nh.z, 0.0f)));

    return reflect(-V, Hlocal.x * T + Hlocal.y * B + Hlocal.z * N);
}

vec3 SampleBrdf(inout uint seed, vec3 N, vec3 V, Material mat)
{
    if (rnd(seed) < SpecularProbability(N, V, mat))
        return SampleGgx(seed, N, V, max(mat.Shininess, 1e-3f));

    float c = sqrt(rnd(seed));
    float phi = 2.0f * PI * rnd(seed);
    return SampleLobe(N, c, phi);
}

// Pdf of SampleBrdf: both lobes can produce any direction, so this is always their mixture.
float PdfBrdf(vec3 N, vec3 L, vec3 V, Material mat)
{
    float dotLN = dot(L, N);
    float dotVN = dot(V, N);
    if (dotLN <= 0.0f || dotVN <= 0.0f)
        return 0.0f;

    vec3 H = normalize(V + L);
    float dotHN = clamp(dot(H, N), 0.0f, 1.0f);
    float dotVH = clamp(dot(V, H), 0.0f, 1.0f);

    float alpha = max(mat.Shininess, 1e-3f);
    float alphaSqr = alpha * alpha;
    float d = dotHN * dotHN * (alphaSqr - 1.0f) + 1.0f;
    float D = alphaSqr / (PI * d * d);

    float pdfSpecular = G1(dotVN, dotVH, alphaSqr) * D / (4.0f * dotVN);
    float pdfDiffuse = dotLN / PI;

    float pS = SpecularProbability(N, V, mat);
    return pS * pdfSpecular + (1.0f - pS) * pdfDiffuse;
}
